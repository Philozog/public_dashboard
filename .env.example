NEWS_API_KEY=your_newsapi_key_here
# Optional. Any Hugging Face text-classification checkpoint.
# Defaults to ProsusAI/finbert when unset.
SENTIMENT_MODEL=ProsusAI/finbert
# Optional absolute path on persistent storage (default: data/portfolio.db).
# APOTHICAIRE_DB=C:/path/to/persistent/portfolio.db
# Only for a hosted copy: one name:password per person. Each person has their
# own portfolio; the first name listed keeps the original one.
# DASHBOARD_USERS=alex:long-password-1, sam:long-password-2
# SECRET_KEY=any-long-random-text
